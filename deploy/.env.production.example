# Copy to deploy/.env.production on the server. Never commit the filled file.
PUBLIC_ORIGIN=https://arc.pact.kant0x.xyz
WEB_PORT=80
POSTGRES_PASSWORD=replace-with-a-long-random-database-password

# Generate independently, with at least 32 random bytes each.
PACT_AUTH_TOKEN=replace-with-a-long-random-operator-token
PACT_SESSION_SECRET=replace-with-a-different-32-byte-minimum-secret
PACT_AUTH_DOMAIN=arc.pact.kant0x.xyz
PACT_CORS_ORIGINS=https://arc.pact.kant0x.xyz,https://pact-protocol.pages.dev
PACT_ARENA_GENERATOR_SECRET=replace-with-a-long-random-arena-secret

# Arc Testnet settlement. Deploy the current contracts before filling these.
PACT_MODE=arc
PACT_ARC_RPC_URL=https://rpc.testnet.arc.network
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
PACT_REPUTATION_REGISTRY_ADDRESS=replace-with-reputation-registry-address
PACT_STREAMING_VAULT_ADDRESS=replace-with-streaming-vault-address
PACT_DISPUTE_MODULE_ADDRESS=replace-with-dispute-module-address
PACT_AGENT_REGISTRY_ADDRESS=replace-with-agent-registry-address
PACT_WORK_ORDER_COMMITMENTS_ADDRESS=replace-with-work-order-commitments-address
PACT_VERIFICATION_REGISTRY_ADDRESS=replace-with-verification-registry-address
PACT_HUB_REGISTRY_ADDRESS=replace-with-hub-registry-address
PACT_MILESTONE_ESCROW_ADDRESS=replace-with-milestone-escrow-address
PACT_SUBSCRIPTION_VAULT_ADDRESS=replace-with-subscription-vault-address
PACT_REWARD_VAULT_ADDRESS=replace-with-reward-vault-address
PACT_DISPUTE_ADMIN_PRIVATE_KEY=replace-with-dispute-admin-key
PACT_VAULT_DEPLOYMENT_BLOCK=replace-with-vault-deployment-block

# Circle Developer-Controlled Wallets. The entity secret authorizes MPC signing
# and belongs only in the server secret manager, never in the web container.
CIRCLE_API_KEY=replace-with-circle-api-key
CIRCLE_ENTITY_SECRET=replace-with-circle-entity-secret
CIRCLE_WALLET_SET_ID=
CIRCLE_WALLET_SET_NAME=PACT Agent Wallets

# Required for the live agent runtime, arena quality judge and arbitration council.
OPENAI_API_KEY=replace-with-your-openai-api-key
# Leave empty for OpenAI. For an OpenRouter key (sk-or-v1-...), set
# https://openrouter.ai/api/v1 and use provider-qualified model IDs.
OPENAI_BASE_URL=
AGENT_MODEL=gpt-4o-mini
# Replace with the promoted ft:gpt-4o-mini... id after its golden eval passes.
ARENA_JUDGE_MODEL=gpt-4o-mini
ARENA_JUDGE_TEACHER_MODEL=gpt-4o-mini
ARBITRATOR_MODEL=gpt-4o-mini

PACT_ARENA_RUNNER_IMAGE=node:22-bookworm-slim
PACT_ARENA_RUNNER_TIMEOUT_MS=8000
ARENA_JUDGE_TIMEOUT_MS=20000
ARENA_JUDGE_MAX_OUTPUT_TOKENS=300
PACT_AGENT_AUTOPILOT_ENABLED=true
PACT_AUTOPILOT_POLL_INTERVAL_MS=15000
PACT_AUTOPILOT_TASK_INTERVAL_SECONDS=300
PACT_AUTOPILOT_MAX_AGENTS_PER_TICK=2
PACT_API_URL=https://replace-with-pact-api.example
ARBITRATOR_TIMEOUT_MS=15000
PACT_RATE_LIMIT_WINDOW_MS=60000
PACT_RATE_LIMIT_MAX=120
PACT_JSON_LIMIT=64kb
PACT_EVIDENCE_MAX_CHARS=20000
PACT_HUMAN_REVIEWER_ID=authorized-human-reviewer

# Arc Testnet Platform Points. The scorer key stays server-side and must be
# authorized by PlatformPoints; never put it in VITE_* variables.
PLATFORM_POINTS_ADDRESS=replace-with-platform-points-contract
PLATFORM_POINTS_AWARDER_PRIVATE_KEY=replace-with-server-side-awarder-key
PLATFORM_POINTS_CHAIN_ID=5042002
PLATFORM_POINTS_RPC_URL=https://rpc.testnet.arc.network
PLATFORM_POINTS_REQUIRED=true

# Optional real marketplace validators. Leave empty to remove these tools from
# the runtime allowlist; no simulated success is returned.
PACT_SOURCE_VERIFIER_URL=
PACT_CODE_VALIDATOR_URL=
PACT_RUNTIME_VALIDATOR_TOKEN=
PACT_RUNTIME_VALIDATOR_TIMEOUT_MS=20000
