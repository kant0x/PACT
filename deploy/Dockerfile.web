FROM node:22-bookworm-slim AS build

WORKDIR /app
COPY package*.json ./
COPY shared/package.json ./shared/
COPY contracts/package.json ./contracts/
COPY services/api/package.json ./services/api/
COPY services/indexer/package.json ./services/indexer/
COPY frontend/package.json ./frontend/
RUN npm ci

COPY shared ./shared
COPY frontend ./frontend
COPY tsconfig.base.json ./tsconfig.base.json
ARG VITE_API_URL=/
ARG VITE_ARC_RPC_URL=https://rpc.testnet.arc.network
ARG VITE_STREAMING_VAULT_ADDRESS
ARG VITE_AGENT_REGISTRY_ADDRESS
ARG VITE_REPUTATION_REGISTRY_ADDRESS
ARG VITE_WORK_ORDER_COMMITMENTS_ADDRESS
ARG VITE_VERIFICATION_REGISTRY_ADDRESS
ARG VITE_HUB_REGISTRY_ADDRESS
ARG VITE_MILESTONE_ESCROW_ADDRESS
ARG VITE_SUBSCRIPTION_VAULT_ADDRESS
ARG VITE_REWARD_VAULT_ADDRESS
ARG VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000
ENV VITE_API_URL=$VITE_API_URL \
    VITE_ARC_RPC_URL=$VITE_ARC_RPC_URL \
    VITE_STREAMING_VAULT_ADDRESS=$VITE_STREAMING_VAULT_ADDRESS \
    VITE_AGENT_REGISTRY_ADDRESS=$VITE_AGENT_REGISTRY_ADDRESS \
    VITE_REPUTATION_REGISTRY_ADDRESS=$VITE_REPUTATION_REGISTRY_ADDRESS \
    VITE_WORK_ORDER_COMMITMENTS_ADDRESS=$VITE_WORK_ORDER_COMMITMENTS_ADDRESS \
    VITE_VERIFICATION_REGISTRY_ADDRESS=$VITE_VERIFICATION_REGISTRY_ADDRESS \
    VITE_HUB_REGISTRY_ADDRESS=$VITE_HUB_REGISTRY_ADDRESS \
    VITE_MILESTONE_ESCROW_ADDRESS=$VITE_MILESTONE_ESCROW_ADDRESS \
    VITE_SUBSCRIPTION_VAULT_ADDRESS=$VITE_SUBSCRIPTION_VAULT_ADDRESS \
    VITE_REWARD_VAULT_ADDRESS=$VITE_REWARD_VAULT_ADDRESS \
    VITE_USDC_ADDRESS=$VITE_USDC_ADDRESS
RUN npm run build -w @pact/frontend

FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY deploy/web-entrypoint.sh /docker-entrypoint.d/99-pact-config.sh
COPY --from=build /app/frontend/dist /usr/share/nginx/html
RUN sed -i 's/\r$//' /docker-entrypoint.d/99-pact-config.sh \
  && chmod +x /docker-entrypoint.d/99-pact-config.sh
EXPOSE 80
